{
  "files.associations": {
    "*.ejs": "html",
    "**/frontmatter.json": "jsonc",
    "**/.frontmatter/config/*.json": "jsonc",
    "*.json.liquid": "json",
    "*.yaml.liquid": "yaml",
    "*.md.liquid": "markdown",
    "*.js.liquid": "liquid-javascript",
    "*.css.liquid": "liquid-css",
    "*.scss.liquid": "liquid-scss",
    "*.err": "log",
    "future": "cpp",
    "*.tcc": "cpp",
    "*.ipp": "cpp",
    "*.inc": "cpp",
    "streambuf": "cpp",
    "any": "cpp",
    "bitset": "cpp",
    "memory": "cpp",
    "random": "cpp",
    "optional": "cpp",
    "typeindex": "cpp",
    "typeinfo": "cpp"
  },
  "cmake.ignoreCMakeListsMissing": true,
  "clangd.arguments": [
    "-j=8",
    "--completion-style=detailed",
    "--header-insertion=iwyu",
    "--suggest-missing-includes",
    "--limit-results=100",
    "--query-driver=/usr/bin/clang++",
    "--all-scopes-completion",
    "--pch-storage=memory",
    "--enable-config",
    "--pretty"
  ],
  "clangd.path": "/usr/bin/clangd",
  "clang-format.executable": "/usr/bin/clang-format",
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.autocomplete": "disabled",
  "cmake.configureOnOpen": false,
  "git.autoRepositoryDetection": "subFolders",
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "git.repositoryScanMaxDepth": 2,
  "scm.diffDecorations": "none",
  "scm.countBadge": "off",
  "search.followSymlinks": false,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.git/lfs/**": true,
    "**/.hg/**": true,
    "**/.svn/**": true,
    "**/.DS_Store": true,
    "**/build/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.cache/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "**/third_party/**": true,
    "**/external/**": true,
    "**/output/**": true,
    "**/dist/**": true,
    "**/test_home/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "search.exclude": {
    "**/.git/**": true,
    "**/.hg/**": true,
    "**/.svn/**": true,
    "**/.DS_Store": true,
    "**/build/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.cache/**": true,
    "**/__pycache__/**": true,
    "**/node_modules/**": true,
    "**/third_party/**": true,
    "**/external/**": true,
    "**/output/**": true,
    "**/dist/**": true,
    "**/test_home/**": true,
    "**/.venv/**": true,
    "**/venv/**": true
  },
  "files.exclude": {
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/__pycache__": true,
    "**/build": true,
    "**/output": true,
    "**/dist": true
  },
  "python.analysis.autoImportCompletions": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false
}
